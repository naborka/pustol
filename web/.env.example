# Where the Rust API listens. The Next server proxies /api to it, so the browser only ever talks
# to this app's own origin.
PUSTOL_API_URL=http://127.0.0.1:8080

# The bot's username, without the @. Used to open the bot's chat when a guest asks for reminders or
# wants to write to the bar.
NEXT_PUBLIC_BOT_USERNAME=pustol_bot

# Local development only. A genuinely signed initData payload, which only somebody holding the bot
# token can produce — the server verifies it exactly as it verifies a real client's, so this is a
# convenience and not a way in.
# NEXT_PUBLIC_DEV_INIT_DATA=
